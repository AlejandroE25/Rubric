ikbBorder = ColorValue("#444444");
ikbRule = ColorValue("#555555");
ikbText = ColorValue("#cccccc");
ikbMuted = ColorValue("#999999");
ikbAccent = ColorValue("#7aaee8");
ikbAccent2 = ColorValue("#aaccff");
ikbFill = ColorValue("#3c5070");
ikbBtn = ColorValue("#3a3a3a");
ikbBtnHover = ColorValue("#484848");
ikbGreen = ColorValue("#6ec86e");
ikbGreenFill = ColorValue("#1a3a1a");
ikbGreenLine = ColorValue("#3a6a3a");
ikbRed = ColorValue("#e08080");
